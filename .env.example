# The Odds API - free tier, 500 requests/month
# Get a key at https://the-odds-api.com
ODDS_API_KEY=

# API-Football (api-sports.io) — optional soccer form / H2H / goals / corners
# Get a key at https://www.api-football.com
API_FOOTBALL_KEY=

# Supabase - Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same Supabase project, public-safe values (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cap leagues per scan (conserves Odds API free-tier credits; default 12)
ODDS_MAX_SPORTS_PER_RUN=12

# Daily analysis window — unlocks once per day at this local hour
ANALYSIS_TZ=Africa/Lagos
ANALYSIS_DAY_START_HOUR=9
